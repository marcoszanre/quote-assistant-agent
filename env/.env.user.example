# Example user secrets file (copy to `env/.env.local.user` or `env/.env.dev.user`)
# NEVER commit `.env.*.user` files to source control.

# Paste your plaintext GitHub OAuth App Client Secret below before running `wiqd agent provision`.
# During provisioning, Microsoft 365 Agents Toolkit / wiqd automatically encrypts this value locally.
SECRET_MCP_DA_OAUTH_CLIENT_SECRET_APIGITHUBC=<your-github-oauth-client-secret>
