# Example environment file for the `local` environment (copy to `env/.env.local`)
# Note: `env/.env.local` is gitignored because provisioning writes tenant/app IDs into it.

# Built-in environment variables
TEAMSFX_ENV=local
APP_NAME_SUFFIX=local

# Generated automatically during `wiqd agent provision --env local`
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
M365_TITLE_ID=
M365_APP_ID=

# GitHub OAuth App configuration for the GitHub Remote MCP Server
# 1. Create a GitHub OAuth App at https://github.com/settings/developers
# 2. Set Authorization callback URL to: https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect
# 3. Paste your OAuth App Client ID below:
MCP_DA_OAUTH_CLIENT_ID_APIGITHUBC=<your-github-oauth-client-id>

# Comma-separated OAuth scopes required by https://api.githubcopilot.com/mcp/
# IMPORTANT: Do NOT use spaces between scopes (oauth/register splits on commas)
MCP_DA_OAUTH_SCOPE_APIGITHUBC=repo,read:org,read:user

# Generated automatically by `oauth/register` during provisioning
# Tip: Clear this value if you change Client ID, Client Secret, or Scopes to force a new vault registration
MCP_DA_AUTH_ID_APIGITHUBC=

# Optional: Environment variables for Agent Evaluations (`wiqd agent eval`)
AZURE_AI_OPENAI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=
AZURE_AI_MODEL_NAME=
