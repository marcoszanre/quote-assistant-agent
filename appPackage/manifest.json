{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
    "manifestVersion": "1.30",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Contoso",
        "websiteUrl": "https://www.contoso.com",
        "privacyUrl": "https://www.contoso.com/privacy",
        "termsOfUseUrl": "https://www.contoso.com/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Quote Assistant${{APP_NAME_SUFFIX}}",
        "full": "Quote Assistant Agent"
    },
    "description": {
        "short": "Inspiring quotes (/quote-spark) and read-only GitHub repos (/github-repos).",
        "full": "Quote Assistant Agent is an M365 Copilot declarative agent with the quote-spark skill (/quote-spark) and the github-repos skill (/github-repos) connected to the GitHub Remote MCP server with read-only repository scope."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": [
        "token.botframework.com",
        "github.com",
        "api.githubcopilot.com"
    ]
}